<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AsyncMusic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AsyncMusic"
    Title="AsyncMusic">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: back button, title (the drag region), diagnostics, then room for the
             system's caption buttons. -->
        <Grid x:Name="titleBar" Grid.Row="0" Padding="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="captionButtonsColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Grid.Column="0" Style="{StaticResource TitleBarButtonStyle}" Click="OnBack"
                    ToolTipService.ToolTip="Back" AutomationProperties.Name="Back" Visibility="Collapsed">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Grid x:Name="dragRegion" Grid.Column="1" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="12,0,0,0">
                    <FontIcon Glyph="&#xE7F5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="titleText" Text="AsyncMusic" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Button x:Name="diagnosticsButton" Grid.Column="2" Style="{StaticResource TitleBarButtonStyle}"
                    Click="OnShowDiagnostics" ToolTipService.ToolTip="Diagnostics" AutomationProperties.Name="Diagnostics">
                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Welcome: host, or join someone else's group. -->
        <ScrollViewer x:Name="welcomePage" Grid.Row="1">
            <!-- A readable column: up to ReadableColumnWidth wide, centered. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1000*" MaxWidth="{StaticResource ReadableColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Style="{StaticResource ReadableColumnStyle}" Spacing="28">
                    <StackPanel Spacing="12" Margin="0,24,0,0">
                        <FontIcon Glyph="&#xE7F5;" FontSize="56" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="AsyncMusic" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Play music in perfect sync across your devices — or split one song into true stereo over two of them."
                                   Style="{StaticResource SecondaryBodyStyle}" TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <Button Style="{StaticResource CardButtonStyle}" Click="OnHost" AutomationProperties.Name="Host Music">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Host Music" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Play from this device. Nearby devices join as speakers." Style="{StaticResource SecondaryCaptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource CardButtonStyle}" Click="OnJoin" AutomationProperties.Name="Join as Speaker">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon Glyph="&#xE7F5;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Join as Speaker" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Play along with a host on the same Wi-Fi." Style="{StaticResource SecondaryCaptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="deviceNameText" Style="{StaticResource SecondaryCaptionStyle}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Join: pick a host nearby, then show what this device plays for it. -->
        <ScrollViewer x:Name="joinPage" Grid.Row="1" Visibility="Collapsed">
            <!-- A readable column: up to ReadableColumnWidth wide, centered. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1000*" MaxWidth="{StaticResource ReadableColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Style="{StaticResource ReadableColumnStyle}" Spacing="16">
                    <StackPanel x:Name="hostListPanel" Style="{StaticResource CardStyle}">
                        <TextBlock Text="Nearby Hosts" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="searchingPanel" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ProgressRing IsActive="True" Width="16" Height="16" />
                                <TextBlock x:Name="searchingText" Text="Looking for hosts…" Style="{StaticResource SecondaryBodyStyle}" />
                            </StackPanel>
                            <TextBlock Text="On the device with the music, open AsyncMusic and choose Host Music. Both devices need to be on the same network."
                                       Style="{StaticResource SecondaryCaptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="hostList" Spacing="4" />
                    </StackPanel>

                    <StackPanel x:Name="speakerPanel" Spacing="16" Visibility="Collapsed">
                        <StackPanel Spacing="14" Padding="0,12">
                            <Grid HorizontalAlignment="Center">
                                <Ellipse x:Name="badgeCircle" Width="120" Height="120" />
                                <TextBlock x:Name="badgeText" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="playingBadge" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-6,-6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE995;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="speakerTitle" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="speakerExplanation" Style="{StaticResource SecondaryBodyStyle}" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Host" />
                                <TextBlock x:Name="hostValue" Grid.Column="1" Style="{StaticResource SecondaryBodyStyle}" />
                            </Grid>
                            <Rectangle Style="{StaticResource DividerStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sync" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="syncDot" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="syncValue" Style="{StaticResource SecondaryBodyStyle}" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource DividerStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Playback" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="playbackDot" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="playbackValue" Style="{StaticResource SecondaryBodyStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <InfoBar x:Name="outputInfoBar" IsOpen="False" IsClosable="False" Severity="Error" Title="Audio output" />
                    </StackPanel>

                    <Button x:Name="leaveButton" Content="Cancel" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnLeave" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Host: what plays, how it is spread over the group, and who is in it. -->
        <ScrollViewer x:Name="hostPage" Grid.Row="1" Visibility="Collapsed">
            <!-- A readable column: up to ReadableColumnWidth wide, centered. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1000*" MaxWidth="{StaticResource ReadableColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Style="{StaticResource ReadableColumnStyle}" Spacing="16">
                    <InfoBar x:Name="hostInfoBar" IsOpen="False" IsClosable="False" Severity="Warning" />

                    <!-- Now playing -->
                    <StackPanel Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <Grid>
                                    <FontIcon x:Name="artworkIcon" Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    <ProgressRing x:Name="loadingRing" IsActive="False" Width="28" Height="28" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="trackTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="trackSubtitle" Style="{StaticResource SecondaryBodyStyle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="progressPanel" Spacing="4" Visibility="Collapsed">
                            <ProgressBar x:Name="trackProgress" Minimum="0" Maximum="1" />
                            <Grid>
                                <TextBlock x:Name="elapsedText" Style="{StaticResource SecondaryCaptionStyle}" />
                                <TextBlock x:Name="remainingText" Style="{StaticResource SecondaryCaptionStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                        <Grid>
                            <Button x:Name="chooseMusicButton" Click="OnChooseMusic" VerticalAlignment="Center" AutomationProperties.Name="Choose Music">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Choose Music" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="playButton" Click="OnPlayStop" HorizontalAlignment="Right" Width="52" Height="52" CornerRadius="26" Padding="0"
                                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Play">
                                <FontIcon x:Name="playIcon" Glyph="&#xE768;" FontSize="20" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Sound: how the music is spread over the group. -->
                    <StackPanel Style="{StaticResource CardStyle}">
                        <TextBlock Text="Sound" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button x:Name="everywhereButton" Style="{StaticResource CardButtonStyle}" Click="OnEverywhere" AutomationProperties.Name="Everywhere">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon Glyph="&#xE995;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Everywhere" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Every device plays the full mix." Style="{StaticResource SecondaryCaptionStyle}" />
                                </StackPanel>
                                <FontIcon x:Name="everywhereCheck" Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>
                        <Button x:Name="stereoButton" Style="{StaticResource CardButtonStyle}" Click="OnStereoPair" AutomationProperties.Name="Stereo Pair">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon Glyph="&#xE7F5;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Stereo Pair" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Two devices play the left and right channels." Style="{StaticResource SecondaryCaptionStyle}" />
                                </StackPanel>
                                <FontIcon x:Name="stereoCheck" Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Stereo pair: which device plays which side. -->
                    <StackPanel x:Name="stereoCard" Style="{StaticResource CardStyle}">
                        <TextBlock Text="Stereo Pair" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Grid HorizontalAlignment="Center">
                                    <Ellipse x:Name="leftBadge" Width="60" Height="60" />
                                    <TextBlock Text="L" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ComboBox x:Name="leftDevice" MinWidth="160" HorizontalAlignment="Center" PlaceholderText="Choose Device" SelectionChanged="OnLeftDeviceChanged"
                                          AutomationProperties.Name="Left Device" />
                                <TextBlock x:Name="leftCaption" Style="{StaticResource SecondaryCaptionStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnSwap" Width="36" Height="36" CornerRadius="18" Padding="0" VerticalAlignment="Top" Margin="0,12,0,0"
                                    ToolTipService.ToolTip="Swap Left and Right" AutomationProperties.Name="Swap Left and Right">
                                <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                            </Button>
                            <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Center">
                                <Grid HorizontalAlignment="Center">
                                    <Ellipse x:Name="rightBadge" Width="60" Height="60" />
                                    <TextBlock Text="R" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ComboBox x:Name="rightDevice" MinWidth="160" HorizontalAlignment="Center" PlaceholderText="Choose Device" SelectionChanged="OnRightDeviceChanged"
                                          AutomationProperties.Name="Right Device" />
                                <TextBlock x:Name="rightCaption" Style="{StaticResource SecondaryCaptionStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="stereoStatusIcon" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock x:Name="stereoStatus" Grid.Column="1" Style="{StaticResource SecondaryBodyStyle}" />
                        </Grid>
                        <Button x:Name="testButton" Click="OnTestChannels" AutomationProperties.Name="Test Left &amp; Right">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="testIcon" Glyph="&#xE7F5;" FontSize="14" />
                                <TextBlock x:Name="testText" Text="Test Left &amp; Right" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Devices in the group. Rows are filled in from code. -->
                    <StackPanel Style="{StaticResource CardStyle}">
                        <TextBlock Text="Devices" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="deviceList" Spacing="12" />
                    </StackPanel>

                    <Button Content="Stop Hosting" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnLeave" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Diagnostics: sync, streaming and output in detail. Rows are filled in from code. -->
        <ScrollViewer x:Name="diagnosticsPage" Grid.Row="1" Visibility="Collapsed">
            <!-- A readable column: up to ReadableColumnWidth wide, centered. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1000*" MaxWidth="{StaticResource ReadableColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Style="{StaticResource ReadableColumnStyle}" Spacing="16">
                    <StackPanel x:Name="generalSection" Style="{StaticResource CardStyle}" />
                    <StackPanel x:Name="leaderSection" Style="{StaticResource CardStyle}" />
                    <StackPanel x:Name="estimateSection" Style="{StaticResource CardStyle}" />
                    <StackPanel x:Name="chartsSection" Style="{StaticResource CardStyle}">
                        <TextBlock Text="Residual vs. fitted line (µs)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Canvas x:Name="residualChart" Height="160" />
                        <TextBlock Text="Best round trip per round (ms)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <Canvas x:Name="roundTripChart" Height="120" />
                    </StackPanel>
                    <StackPanel x:Name="playbackSection" Style="{StaticResource CardStyle}" />
                    <StackPanel x:Name="outputSection" Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="outputRows" Spacing="12" />
                        <Rectangle Style="{StaticResource DividerStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Extra delay" />
                            <TextBlock x:Name="offsetValue" Grid.Column="1" Style="{StaticResource SecondaryBodyStyle}" />
                        </Grid>
                        <Slider x:Name="offsetSlider" Minimum="-100" Maximum="300" StepFrequency="0.5" ValueChanged="OnOffsetChanged" />
                        <TextBlock Text="Increase if this device sounds late compared with the others; decrease if it sounds early."
                                   Style="{StaticResource SecondaryCaptionStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource CardStyle}">
                        <TextBlock Text="Device Name" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="nameBox" />
                            <Button Grid.Column="1" Content="Save" Click="OnRename" />
                        </Grid>
                        <TextBlock Text="How hosts list this device. Leave empty to use the computer's name. Takes effect the next time you join."
                                   Style="{StaticResource SecondaryCaptionStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Copy Report" Click="OnCopyReport" />
                            <Button Grid.Column="2" Content="Clear" Click="OnClearLog" />
                        </Grid>
                        <TextBlock x:Name="logText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
